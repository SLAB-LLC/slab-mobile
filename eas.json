{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "rm -rf .expo && npx expo prebuild --no-install",
      "cache": {
        "key": "v2"
      }
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "rm -rf .expo && npx expo prebuild --no-install"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "rm -rf .expo && npx expo prebuild --no-install"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760921958"
      }
    }
  }
}
