{
  "expo": {
    "name": "SLAB Voice",
    "slug": "slab-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/slab-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D4AF37"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slabvoice.mobile",
      "buildNumber": "5",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record and transcribe audio.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload audio files.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/slab-logo.png",
        "backgroundColor": "#D4AF37"
      },
      "package": "com.slabvoice.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/slab-logo.png",
          "color": "#f39c12",
          "sounds": []
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/a08565c5-4ff9-4648-9eba-ef3cf346bf0c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "a08565c5-4ff9-4648-9eba-ef3cf346bf0c"
      }
    },
    "owner": "slab_training"
  }
}
